# Full "Display Name <email@domain>" format, e.g. "Huge Requirements Limited <info@hugerequirements.co.uk>".
# Used for job-application emails AND (as of the auth-email overhaul) the
# verification/welcome/password-reset emails sent via src/lib/auth-email.ts.
RESEND_FROM_EMAIL=
RESEND_ADMIN_NOTIFICATION_EMAIL=

BLOB_READ_WRITE_TOKEN=

# Also gates account-level auth rate limits (verification-email resend,
# forgot-password, verification-complete) in addition to the original guest
# application/CV-upload limits — see src/lib/rate-limit.ts. Rate limiting
# fails open (allows the request) if these are unset, so this matters for
# production, not local development.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

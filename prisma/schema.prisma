// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id           String     @id @default(cuid())
  firebaseUid  String     @unique
  firstName    String
  lastName     String
  email        String     @unique
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  verificationEmailSentAt DateTime?
  welcomeEmailSentAt      DateTime?

  createdJobs Job[] @relation("JobCreatedBy")
  updatedJobs Job[] @relation("JobUpdatedBy")

  candidateProfile CandidateProfile?
}

enum SectorName {
  PRODUCTION
  WAREHOUSING
  MANUFACTURING
  DISTRIBUTION
  AUTOMOTIVE
}

enum JobStatus {
  DRAFT
  PUBLISHED
  PAUSED
  CLOSED
  ARCHIVED
}

enum EmploymentType {
  PERMANENT
  TEMPORARY
  TEMP_TO_PERM
  FIXED_TERM
  CONTRACT
}

enum PayType {
  NUMERIC
  COMPETITIVE
}

enum PayPeriod {
  HOUR
  DAY
  WEEK
  MONTH
  YEAR
}

enum ShiftCategory {
  DAY
  NIGHT
  ROTATING
  WEEKEND
  FLEXIBLE
  OTHER
}

enum ApplicationStatus {
  NEW
  REVIEWING
  SHORTLISTED
  REJECTED
  HIRED
  WITHDRAWN
}

model Sector {
  id        String     @id @default(cuid())
  name      SectorName @unique
  label     String
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  jobs Job[]
}

model Client {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs Job[]
}

model Job {
  id       String @id @default(cuid())
  title    String
  slug     String @unique

  sectorId       String
  sector         Sector         @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  employmentType EmploymentType
  overview       String
  status         JobStatus      @default(DRAFT)

  townOrCity     String
  countyOrRegion String?
  postcode       String?

  payType                   PayType
  currency                  String  @default("GBP")
  additionalPayInformation  String?

  referenceCode String? @unique

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  shortDescription       String?
  startDate              DateTime?
  closingDate            DateTime?
  vacancyCount           Int?
  hoursPerWeek           Decimal?
  shiftSummary           String?
  additionalInformation  String?
  showPostedDate         Boolean   @default(true)
  featured               Boolean   @default(false)

  publishedAt DateTime?
  closedAt    DateTime?

  createdById String?
  createdBy   User?   @relation("JobCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?   @relation("JobUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payRates         JobPayRate[]
  shifts           JobShift[]
  responsibilities JobResponsibility[]
  requirements     JobRequirement[]
  benefits         JobBenefit[]
  applications     JobApplication[]

  @@index([status, publishedAt])
  @@index([sectorId])
  @@index([employmentType])
  @@index([townOrCity])
}

model JobPayRate {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  label   String?
  minimum Decimal
  maximum Decimal?
  period  PayPeriod

  isPrimary    Boolean @default(false)
  displayOrder Int     @default(0)

  @@index([jobId])
}

model JobShift {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  category  ShiftCategory
  label     String?
  startTime String?
  endTime   String?
  days      String?
  details   String?

  displayOrder Int @default(0)

  @@index([jobId])
}

model JobResponsibility {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  text         String
  displayOrder Int    @default(0)

  @@index([jobId])
}

model JobRequirement {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  text         String
  displayOrder Int    @default(0)

  @@index([jobId])
}

model JobBenefit {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  text         String
  displayOrder Int    @default(0)

  @@index([jobId])
}

enum HoursAvailability {
  ZERO_TO_TEN
  TEN_TO_TWENTY
  TWENTY_TO_THIRTY
  THIRTY_PLUS
}

enum TransportMode {
  CAR
  BUS
  TAXI
  CYCLE
  WALK
  TRAIN
}

enum EmergencyContactRelationship {
  SPOUSE_PARTNER
  RELATIVE_FAMILY
  FRIEND
  OTHER
}

enum ReferralSource {
  INDEED_JOB_BOARD
  GOOGLE_SEARCH
  SOCIAL_MEDIA
  FRIEND_COLLEAGUE_REFERRAL
  JOBCENTRE_PLUS
  OTHER
}

enum AvailabilityToStart {
  IMMEDIATE
  NEXT_WEEK
  TWO_TO_THREE_WEEKS
  FOUR_WEEKS_PLUS
}

enum CandidateTitle {
  MR
  MRS
  MISS
  MS
  DR
  OTHER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum RightToWorkDocumentType {
  PASSPORT
  ID_CARD
  BRP_EVISA
}

enum BrpSubtype {
  PHYSICAL_BRP
  EVISA
}

model CandidateProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  onboardingStep   Int       @default(1)
  step1CompletedAt DateTime?

  // Section A — Personal Details
  title       CandidateTitle?
  firstName   String?
  middleName  String?
  surname     String?
  gender      Gender?
  dateOfBirth DateTime?
  nationality String?
  niNumber    String?

  // Section B — Eligibility & Declarations
  isStudying            Boolean?
  hasUnspentConvictions Boolean?

  // Section C — Contact Details
  mobileDialCode String?
  mobileNumber   String?
  avatarS3Key    String?

  // Section D — Residential Address
  addressLine1   String?
  addressLine2   String?
  townOrCity     String?
  countyOrRegion String?
  postcode       String?

  step2CompletedAt DateTime?

  // Step 2 — Work Information
  preferredWorkLocation String?
  hoursAvailability     HoursAvailability?
  availabilityToStart   AvailabilityToStart?
  interestedSectors     SectorName[]         @default([])
  transportMode         TransportMode?
  shoeSize              Decimal?

  // Step 2 — Emergency Contact
  emergencyContactName         String?
  emergencyContactMobile       String?
  emergencyContactRelationship EmergencyContactRelationship?

  // Step 2 — Additional Information
  referralSource ReferralSource?

  step3CompletedAt DateTime?

  // Step 3 — Proof of Right to Work
  rightToWorkDocumentType             RightToWorkDocumentType?
  brpSubtype                          BrpSubtype?
  visaExpiryDate                      DateTime?
  rightToWorkShareCode                String?
  rightToWorkShareCodeExpiryDate      DateTime?
  rightToWorkDocFrontS3Key            String?
  rightToWorkDocFrontOriginalFilename String?
  rightToWorkDocBackS3Key             String?
  rightToWorkDocBackOriginalFilename  String?

  // Step 3 — Bank Details
  bankAccountHolderName         String?
  bankAccountNumber             String?
  bankSortCode                  String?
  bankStatementS3Key            String?
  bankStatementOriginalFilename String?

  workReferences CandidateWorkReference[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model CandidateWorkReference {
  id                 String           @id @default(cuid())
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  jobTitle       String
  companyName    String
  companyAddress String?
  startDate      DateTime
  endDate        DateTime?
  isCurrentJob   Boolean  @default(false)
  managerName    String?
  managerMobile  String?
  managerEmail   String?
  displayOrder   Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateProfileId])
}

model JobApplication {
  id              String @id @default(cuid())
  publicReference String @unique

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Restrict)

  fullName String
  email    String
  phone    String
  location String

  status ApplicationStatus @default(NEW)

  privacyConsentAt     DateTime
  privacyPolicyVersion String

  cvBlobPathname     String?
  cvOriginalFilename String?
  cvMimeType         String?
  cvSizeBytes        Int?
  cvUploadedAt       DateTime?
  cvUploadState      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId, status])
  @@index([createdAt])
  @@index([email, jobId, createdAt])
}
